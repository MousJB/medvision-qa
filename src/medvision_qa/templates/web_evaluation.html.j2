{% extends "web_layout.html.j2" %}
{% block title %}{{ record.title }} — MedVision QA{% endblock %}
{% block content %}
<h1>{{ record.title }}</h1>
<p class="muted">{{ _("r.run") }} <code>{{ record.run_id }}</code> · {{ record.created_at_utc }} UTC · {{ _("web.cases_n", n=record.n_cases) }} ·
<code>{{ record.version_a }}</code>{% if record.version_b %} → <code>{{ record.version_b }}</code>{% endif %}</p>

<p><strong>{{ _("r.overall") }}</strong> {{ state(record.decision) }} — {{ tr(decision_reason) }}</p>

<table>
  <tr><th>{{ _("web.col_criterion") }}</th><th>{{ _("r.quantity") }}</th><th>{{ _("r.state") }}</th><th>{{ _("r.justification") }}</th></tr>
  {% for c in criteria %}
  <tr><td>{{ c.id }} — {{ c.description }}</td><td><code>{{ c.quantity }}</code></td>
      <td>{{ state(c.state) }}</td><td>{{ tr(c.reason) }}</td></tr>
  {% endfor %}
</table>

<p class="actions">
  <a href="{{ url('/evaluations/' ~ record.run_id ~ '/report') }}">{{ _("web.open_report") }}</a>
  <a href="{{ url('/evaluations/' ~ record.run_id ~ '/report/download') }}">{{ _("web.download_report") }}</a>
  <a href="{{ url('/') }}">{{ _("web.new_evaluation") }}</a>
</p>
<p class="note">{{ _("web.report_note") }} <code>{{ record.config_sha256 }}</code></p>
{% endblock %}
