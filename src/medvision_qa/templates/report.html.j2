<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("r.html_title") }} — {{ title }}</title>
<style>
  :root { --fg:#1d232a; --muted:#5b6672; --line:#d5dbe1; --bg-alt:#f4f6f8;
          --ok:#1f6f3f; --ok-bg:#e4f3ea; --ko:#a32222; --ko-bg:#fbe7e7; --inc:#8a5a00; --inc-bg:#fdf1d8; }
  * { box-sizing: border-box; }
  body { font: 15px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, "Hiragino Sans", "Yu Gothic UI", Meiryo, sans-serif;
         color: var(--fg); max-width: 1100px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 1.6rem; margin: 0 0 4px; }
  h2 { font-size: 1.15rem; margin: 32px 0 8px; padding-top: 8px; border-top: 1px solid var(--line); }
  h3 { font-size: 1rem; margin: 16px 0 6px; }
  .muted, .note { color: var(--muted); }
  .note { font-size: .85rem; }
  code, .mono { font-family: ui-monospace, Consolas, monospace; font-size: .85rem; word-break: break-all; }
  table { border-collapse: collapse; width: 100%; margin: 8px 0; font-size: .9rem; }
  th, td { border: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
  th { background: var(--bg-alt); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .state { display: inline-block; padding: 1px 8px; border-radius: 4px; font-weight: 700; font-size: .85rem; }
  .SATISFIED { color: var(--ok); background: var(--ok-bg); }
  .NOT_SATISFIED { color: var(--ko); background: var(--ko-bg); }
  .INCONCLUSIVE { color: var(--inc); background: var(--inc-bg); }
  .banner { border: 1px solid var(--line); border-left: 5px solid var(--inc); background: var(--inc-bg);
            padding: 8px 12px; margin: 12px 0; }
  .disclaimer { border-left-color: var(--muted); background: var(--bg-alt); }
  .decision { border: 1px solid var(--line); padding: 12px 16px; margin: 16px 0; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 8px 0; }
  dt { font-weight: 600; } dd { margin: 0; }
  nav ol { columns: 2; font-size: .9rem; }
  .not-provided { color: var(--muted); font-style: italic; }
  @media print { nav { display: none; } h2 { break-after: avoid; } table { break-inside: avoid; } }
</style>
</head>
<body>
{% macro value(v) %}{% if v is none %}<span class="not-provided">{{ _("r.not_provided") }}</span>{% else %}{{ tr(v) }}{% endif %}{% endmacro %}
{% macro interval(cell) %}<td class="num">{{ cell.estimate }}</td><td class="num">{% if cell.defined %}[{{ cell.lower }}, {{ cell.upper }}]{% else %}—{% endif %}</td>{% endmacro %}
{% macro state(s) %}<span class="state {{ s }}">{{ _("state." ~ s) }}</span>{% endmacro %}

<header>
  <p class="muted">{{ _("r.html_title") }} · MedVision QA {{ run.packages["medvision-qa"] }}</p>
  <h1>{{ title }}</h1>
  <p class="muted">{{ _("r.run") }} <code>{{ run.run_id }}</code> · {{ run.started_at_utc }}</p>
  {% if data_nature == "synthetic" %}
  <div class="banner"><strong>{{ _("r.synthetic_title") }}</strong> {{ _("r.synthetic_banner") }}</div>
  {% endif %}
  <div class="banner disclaimer">{{ _("r.disclaimer") }}</div>
  <div class="decision">
    <strong>{{ _("r.overall") }}</strong> {{ state(decision.state) }} — {{ tr(decision.reason) }}
    <div class="note">{{ _("r.aggregation_rule") }} {{ tr(aggregation_rule) }}</div>
  </div>
</header>

<nav><ol>
  {% for i in range(1, 22) %}<li><a href="#s{{ i }}">{{ _("r.s" ~ i) }}</a></li>{% endfor %}
</ol></nav>

<h2 id="s1">1. {{ _("r.s1") }}</h2>
<dl>
  <dt>{{ _("r.run_id") }}</dt><dd><code>{{ run.run_id }}</code> {{ _("r.run_id_note") }}</dd>
  <dt>{{ _("r.configuration") }}</dt><dd><code>{{ config_file }}</code> — SHA-256 <code>{{ config_sha256 }}</code></dd>
</dl>

<h2 id="s2">2. {{ _("r.s2") }}</h2>
<p>{{ run.started_at_utc }} {{ _("r.started_utc") }}</p>

<h2 id="s3">3. {{ _("r.s3") }}</h2>
<dl>
  <dt>{{ _("r.title") }}</dt><dd>{{ title }}</dd>
  <dt>{{ _("r.objective") }}</dt><dd>{{ value(objective) }}</dd>
  <dt>{{ _("r.type") }}</dt><dd>{% if version_names | length == 2 %}{{ _("r.paired_type", n=n_cases) }}{% else %}{{ _("r.single_type", n=n_cases) }}{% endif %}</dd>
</dl>

<h2 id="s4">4. {{ _("r.s4") }}</h2>
<table>
  <tr><th>{{ _("r.role") }}</th><th>{{ _("r.identifier") }}</th><th>{{ _("r.description") }}</th><th>{{ _("r.scores_provided") }}</th></tr>
  {% for v in versions %}
  <tr><td>{{ v.name }} — {{ _("r.reference") if v.name == "A" else _("r.candidate") }}</td><td><code>{{ v.id }}</code></td>
      <td>{{ value(v.description) }}</td><td>{{ _("r.yes") if v.has_scores else _("r.no") }}</td></tr>
  {% endfor %}
</table>

<h2 id="s5">5. {{ _("r.s5") }}</h2>
<table>
  <tr><th>{{ _("r.version") }}</th><th>{{ _("r.code_commit") }}</th><th>{{ _("r.weights_sha256") }}</th></tr>
  {% for v in versions %}
  <tr><td>{{ v.name }}</td><td class="mono">{{ value(v.code_commit) }}</td><td class="mono">{{ value(v.weights_sha256) }}</td></tr>
  {% endfor %}
</table>
<p class="note">{{ _("r.declared_note") }}</p>

<h2 id="s6">6. {{ _("r.s6") }}</h2>
<dl>
  <dt>{{ _("r.description") }}</dt><dd>{{ value(data_description) }}</dd>
  <dt>{{ _("r.data_nature") }}</dt><dd>{{ value(data_nature_label) }}</dd>
  <dt>{{ _("r.manifest_sha256") }}</dt><dd class="mono">{{ value(manifest_sha256) }}</dd>
</dl>

<h2 id="s7">7. {{ _("r.s7") }}</h2>
<table>
  <tr><th>{{ _("r.role") }}</th><th>{{ _("r.file_relative") }}</th><th>{{ _("r.sha256_computed") }}</th><th>{{ _("r.rows") }}</th></tr>
  {% for role, path, source in files %}
  <tr><td>{{ tr(role) }}</td><td><code>{{ path }}</code></td><td class="mono">{{ source.sha256 }}</td><td class="num">{{ source.n_rows }}</td></tr>
  {% endfor %}
</table>
<p class="note">{{ _("r.not_provided_note") }}</p>

<h2 id="s8">8. {{ _("r.s8") }}</h2>
<table>
  <tr><th>{{ _("r.version") }}</th><th>{{ _("r.declared_preprocessing") }}</th></tr>
  {% for v in versions %}<tr><td>{{ v.name }}</td><td>{{ value(v.preprocessing) }}</td></tr>{% endfor %}
</table>
<dl>
  <dt>{{ _("r.seed") }}</dt><dd>{{ statistics.seed }}</dd>
  <dt>{{ _("r.tolerance") }}</dt><dd>{{ statistics.tolerance }}</dd>
  <dt>Python</dt><dd>{{ run.python }}</dd>
  <dt>{{ _("r.dependencies") }}</dt><dd>{% for name, ver in run.packages.items() %}<code>{{ name }}=={{ ver }}</code>{{ ", " if not loop.last else "" }}{% endfor %}</dd>
</dl>

<h2 id="s9">9. {{ _("r.s9") }}</h2>
<dl>
  <dt>{{ _("r.declared_order") }}</dt><dd>{% for c in classes %}<code>{{ loop.index0 }}: {{ c }}</code>{{ ", " if not loop.last else "" }}{% endfor %}</dd>
  <dt>{{ _("r.binary_task") }}</dt><dd>{% if positive %}{{ _("r.binary_definition", positive=positive | join(", "), negative=negatives | join(", ")) }}{% else %}{{ _("r.no_binary_task") }}{% endif %}</dd>
</dl>

<h2 id="s10">10. {{ _("r.s10") }}</h2>
<p>{{ _("r.ground_truth_mode") }} <code>{{ ground_truth_mode }}</code>. {{ _("r.alignment", n=n_cases) }}</p>
<table>
  <tr><th>{{ _("r.file") }}</th><th>{{ _("r.checks_run") }}</th></tr>
  {% for role, path, source in files %}
  <tr><td>{{ tr(role) }}</td><td class="mono">{{ source.checks | join(", ") }}</td></tr>
  {% endfor %}
</table>

<h2 id="s11">11. {{ _("r.s11") }}</h2>
<table>
  <tr><th rowspan="2">{{ _("r.metric") }}</th>{% for v in version_names %}<th colspan="2">{{ _("r.version_n", v=v) }}</th>{% endfor %}<th rowspan="2">{{ _("r.remarks") }}</th></tr>
  <tr>{% for v in version_names %}<th>{{ _("r.estimate") }}</th><th>{{ _("r.ci_level", level=(statistics.confidence_level * 100) | round(1)) }}</th>{% endfor %}</tr>
  {% for row in metric_rows %}
  <tr><td><code>{{ row.key }}</code></td>
    {% for cell in row.cells %}{{ interval(cell) }}{% endfor %}
    <td class="note">{% for cell in row.cells %}{% set name = version_names[loop.index0] %}{% for note in cell.notes %}{{ name }}: {{ tr(note) }}<br>{% endfor %}{% endfor %}</td></tr>
  {% endfor %}
</table>
<h3>{{ _("r.definitions") }}</h3>
<dl>{% for name, text in definitions.items() %}<dt><code>{{ name }}</code></dt><dd>{{ tr(text) }}</dd>{% endfor %}</dl>

<h2 id="s12">12. {{ _("r.s12") }}</h2>
<p class="note">{{ _("r.confusion_note") }}</p>
{% for v, matrix in confusion %}
<h3>{{ _("r.version_n", v=v) }}</h3>
<table>
  <tr><th></th>{% for c in classes %}<th>{{ c }}</th>{% endfor %}</tr>
  {% for row in matrix %}<tr><th>{{ classes[loop.index0] }}</th>{% for n in row %}<td class="num">{{ n }}</td>{% endfor %}</tr>{% endfor %}
</table>
{% endfor %}

<h2 id="s13">13. {{ _("r.s13") }}</h2>
<dl>
  <dt>{{ _("r.method") }}</dt><dd>{{ _("r.method_value", method=_("method." ~ settings.method), quantiles=_("quantiles." ~ settings.quantile_method)) }}</dd>
  <dt>{{ _("r.level") }}</dt><dd>{{ settings.confidence_level }}</dd>
  <dt>{{ _("r.resamples") }}</dt><dd>{{ settings.n_resamples }}</dd>
  <dt>{{ _("r.seed") }}</dt><dd>{{ settings.seed }}</dd>
  <dt>{{ _("r.unit") }}</dt><dd>{{ _("r.unit_value", unit=_("unit." ~ settings.unit), n=settings.n_units) }}</dd>
</dl>
<p class="note">{{ _("r.ci_note") }}</p>

<h2 id="s14">14. {{ _("r.s14") }}</h2>
{% if difference_rows %}
<h3>{{ _("r.paired_differences") }}</h3>
<table>
  <tr><th>{{ _("r.metric") }}</th><th>Δ</th><th>{{ _("r.ci") }}</th><th>{{ _("r.remarks") }}</th></tr>
  {% for row in difference_rows %}
  <tr><td><code>{{ row.key }}</code></td>{{ interval(row.cell) }}<td class="note">{% for note in row.cell.notes %}{{ tr(note) }}{{ "; " if not loop.last else "" }}{% endfor %}</td></tr>
  {% endfor %}
</table>
<h3>{{ _("r.mcnemar_title") }}</h3>
<dl>
  <dt>{{ _("r.method") }}</dt><dd>{{ tr(mcnemar.method) }}</dd>
  <dt>{{ _("r.pairs") }}</dt><dd>{{ _("r.pairs_value", both=mcnemar.both_correct, a=mcnemar.only_reference_correct, b=mcnemar.only_candidate_correct, none=mcnemar.both_wrong) }}</dd>
  <dt>{{ _("r.p_value") }}</dt><dd>{% if mcnemar.p_value is none %}{{ _("r.not_applicable") }} — {{ tr(mcnemar.not_applicable_reason) }}{% else %}{{ mcnemar_p }}{% endif %}</dd>
</dl>
<p class="note">{{ _("r.mcnemar_note") }}</p>
<h3>{{ _("r.delong") }}</h3>
<p>{{ tr(delong_status) }}</p>
{% else %}
<p>{{ _("r.tests_not_run") }}</p>
{% endif %}

<h2 id="s15">15. {{ _("r.s15") }}</h2>
<table>
  <tr><th>{{ _("r.id") }}</th><th>{{ _("r.description") }}</th><th>{{ _("r.kind") }}</th><th>{{ _("r.quantity") }}</th><th>{{ _("r.parameter") }}</th></tr>
  {% for r in criteria %}
  <tr><td>{{ r.c.id }}</td><td>{{ r.c.description }}</td><td><code>{{ r.c.kind }}</code></td><td><code>{{ r.quantity }}</code></td><td>{{ tr(r.parameter) }}</td></tr>
  {% endfor %}
</table>
<p class="note">{{ _("r.criteria_note") }} <code>{{ config_sha256 }}</code></p>

<h2 id="s16">16. {{ _("r.s16") }}</h2>
<table>
  <tr><th>{{ _("r.id") }}</th><th>{{ _("r.state") }}</th><th>{{ _("r.estimate") }}</th><th>{{ _("r.ci") }}</th><th>{{ _("r.justification") }}</th></tr>
  {% for r in criteria %}
  <tr><td>{{ r.c.id }}</td><td>{{ state(r.state) }}</td>{{ interval(r.cell) }}<td>{{ tr(r.reason) }}</td></tr>
  {% endfor %}
</table>
<p><strong>{{ _("r.overall") }}</strong> {{ state(decision.state) }} — {{ tr(decision.reason) }}</p>
<p class="note">{{ tr(aggregation_rule) }} {{ _("r.inconclusive_note") }}</p>

<h2 id="s17">17. {{ _("r.s17") }}</h2>
<dl>
  <dt>{{ _("r.actual_size") }}</dt><dd>{% if settings.unit == "patient" %}{{ _("r.cases_and_patients", cases=n_cases, patients=settings.n_units) }}{% else %}{{ _("r.cases_n", n=n_cases) }}{% endif %}</dd>
  <dt>{{ _("r.justification") }}</dt><dd>{{ value(sample_size_label) }}</dd>
  {% if sample_size_text %}<dt>{{ _("r.provided_text") }}</dt><dd>{{ sample_size_text }}</dd>{% endif %}
</dl>
{% if sample_size_warning %}<div class="banner">{{ tr(sample_size_warning) }}</div>{% endif %}

<h2 id="s18">18. {{ _("r.s18") }}</h2>
<p>{{ _("r.robustness_not_run") }}</p>

<h2 id="s19">19. {{ _("r.s19") }}</h2>
<ul>{% for item in not_available %}<li>{{ tr(item) }}</li>{% endfor %}</ul>

<h2 id="s20">20. {{ _("r.s20") }}</h2>
<ul>{% for item in limitations %}<li>{{ tr(item) }}</li>{% endfor %}</ul>

<h2 id="s21">21. {{ _("r.s21") }}</h2>
<ul>{% for item in cannot_establish %}<li>{{ tr(item) }}</li>{% endfor %}</ul>

<footer class="note"><p>{{ _("r.footer", version=run.packages["medvision-qa"]) }}</p></footer>
</body>
</html>
