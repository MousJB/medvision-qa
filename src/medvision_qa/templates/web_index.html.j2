{% extends "web_layout.html.j2" %}
{% block content %}
<h1>{{ _("web.new_evaluation") }}</h1>
<p>{{ _("web.intro") }} <code>ground_truth_file = "ground_truth.csv"</code></p>

{% if errors %}
<div class="errors" role="alert"><ul>{% for e in errors %}<li>{{ tr(e) }}</li>{% endfor %}</ul></div>
{% endif %}

<form class="upload" action="{{ url('/evaluations') }}" method="post" enctype="multipart/form-data">
  <label for="config">{{ _("web.config_label") }}</label>
  <input id="config" name="config" type="file" accept=".toml" required>
  <label for="data_files">{{ _("web.csv_label", max=max_files) }}</label>
  <input id="data_files" name="data_files" type="file" accept=".csv" multiple required>
  <p class="note">{{ _("web.size_note", mb=max_mb) }}</p>
  <button type="submit">{{ _("web.submit") }}</button>
</form>

{% set docs = "docs/ja/" if lang == "ja" else "docs/" %}
<p class="note">{{ _("web.examples") }}
{% for name in example_files %}<a href="/examples/{{ name }}">{{ name }}</a>{{ " · " if not loop.last else "" }}{% endfor %}.
{{ _("web.format_docs") }} <code>{{ docs }}data_format.md</code>, <code>{{ docs }}evaluation_config.md</code></p>

<h2>{{ _("web.history") }}</h2>
{% if history %}
<table>
  <tr><th>{{ _("web.col_date") }}</th><th>{{ _("web.col_evaluation") }}</th><th>{{ _("web.col_versions") }}</th><th>{{ _("web.col_cases") }}</th><th>{{ _("web.col_decision") }}</th></tr>
  {% for r in history %}
  <tr>
    <td>{{ r.created_at_utc }}</td>
    {% if r.status == "completed" %}
    <td><a href="{{ url('/evaluations/' ~ r.run_id) }}">{{ r.title }}</a></td>
    <td><code>{{ r.version_a }}</code>{% if r.version_b %} → <code>{{ r.version_b }}</code>{% endif %}</td>
    <td>{{ r.n_cases }}</td>
    <td>{{ state(r.decision) }}</td>
    {% else %}
    {% set messages = load_messages(r.error) %}
    <td class="rejected" colspan="3">{{ _("web.rejected_row", error=tr(messages[0]) if messages else "—") }}</td>
    <td class="rejected">—</td>
    {% endif %}
  </tr>
  {% endfor %}
</table>
{% else %}
<p class="muted">{{ _("web.no_history") }}</p>
{% endif %}
{% endblock %}
