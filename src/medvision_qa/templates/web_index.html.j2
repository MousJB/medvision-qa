{% extends "web_layout.html.j2" %}
{% block content %}
<h1>{{ _("web.headline") }}</h1>
<p class="lead">{{ _("web.tagline") }}</p>
<ul>
  <li>{{ _("web.feature_validation") }}</li>
  <li>{{ _("web.feature_intervals") }}</li>
  <li>{{ _("web.feature_decision") }}</li>
  <li>{{ _("web.feature_report") }}</li>
</ul>

<h2>{{ _("web.try_title") }}</h2>
<div class="cards">
  <a class="card" href="{{ url('/demo/synthetic') }}"><strong>{{ _("web.demo_synthetic_title") }} →</strong><br>
    <span class="muted">{{ _("web.demo_synthetic_text") }}</span></a>
  <a class="card" href="{{ url('/demo/brain-mri') }}"><strong>{{ _("web.demo_mri_title") }} →</strong><br>
    <span class="muted">{{ _("web.demo_mri_text") }}</span></a>
  <a class="card" href="{{ url('/demo/rsna-pneumonia') }}"><strong>{{ _("web.demo_rsna_title") }} →</strong><br>
    <span class="muted">{{ _("web.demo_rsna_text") }}</span></a>
</div>
<p class="note">{{ _("web.try_note") }}</p>

<h2>{{ _("web.new_evaluation") }}</h2>
{% if public %}<p class="notice">{{ _("web.public_notice") }}</p>{% endif %}
<p>{{ _("web.intro") }} <code>ground_truth_file = "ground_truth.csv"</code></p>

{% if errors %}
<div class="errors" role="alert"><ul>{% for e in errors %}<li>{{ tr(e) }}</li>{% endfor %}</ul></div>
{% endif %}

<form class="upload" action="{{ url('/evaluations') }}" method="post" enctype="multipart/form-data">
  <label for="config">{{ _("web.config_label") }}</label>
  <input id="config" name="config" type="file" accept=".toml" required>
  <label for="data_files">{{ _("web.csv_label", max=max_files) }}</label>
  <input id="data_files" name="data_files" type="file" accept=".csv" multiple required>
  {% if public %}
  <p class="note">{{ _("web.public_limits", mb=max_mb, max=max_resamples) }}</p>
  {% else %}
  <p class="note">{{ _("web.size_note", mb=max_mb) }}</p>
  {% endif %}
  <button type="submit">{{ _("web.submit") }}</button>
</form>

{% set docs = "docs/ja/" if lang == "ja" else "docs/" %}
<p class="note">{{ _("web.examples") }}
{% for name in example_files %}<a href="/examples/{{ name }}">{{ name }}</a>{{ " · " if not loop.last else "" }}{% endfor %}.
{{ _("web.format_docs") }} <a href="{{ github }}/blob/main/{{ docs }}data_format.md"><code>{{ docs }}data_format.md</code></a>,
<a href="{{ github }}/blob/main/{{ docs }}evaluation_config.md"><code>{{ docs }}evaluation_config.md</code></a></p>

{% set config_name = "config.ja.toml" if lang == "ja" else "config.toml" %}
<div class="previews">
<p class="note">{{ _("web.preview_intro") }} <a href="{{ url('/demo/synthetic') }}">{{ _("web.preview_result") }}</a></p>
{% if config_name in previews %}
<details><summary><code>{{ config_name }}</code> — {{ _("web.preview_config") }}</summary>
<pre>{{ previews[config_name].text }}</pre></details>
{% endif %}
{% for name in example_files if name.endswith(".csv") and name in previews %}
{% set p = previews[name] %}
<details><summary><code>{{ name }}</code> — {{ _("web.preview_rows", shown=p.rows|length, total=p.total) }}</summary>
<div class="scroll"><table>
  <tr>{% for h in p.header %}<th><code>{{ h }}</code></th>{% endfor %}</tr>
  {% for row in p.rows %}<tr>{% for v in row %}<td><code>{{ v }}</code></td>{% endfor %}</tr>
  {% endfor %}
</table></div></details>
{% endfor %}
</div>

{% if not public %}
<h2>{{ _("web.history") }}</h2>
{% if history %}
<div class="scroll"><table>
  <tr><th>{{ _("web.col_date") }}</th><th>{{ _("web.col_evaluation") }}</th><th>{{ _("web.col_versions") }}</th><th>{{ _("web.col_cases") }}</th><th>{{ _("web.col_decision") }}</th></tr>
  {% for r in history %}
  <tr>
    <td>{{ r.created_at_utc }}</td>
    {% if r.status == "completed" %}
    <td><a href="{{ url('/evaluations/' ~ r.run_id) }}">{{ r.title }}</a></td>
    <td><code>{{ r.version_a }}</code>{% if r.version_b %} → <code>{{ r.version_b }}</code>{% endif %}</td>
    <td>{{ r.n_cases }}</td>
    <td>{{ state(r.decision) }}</td>
    {% else %}
    {% set messages = load_messages(r.error) %}
    <td class="rejected" colspan="3">{{ _("web.rejected_row", error=tr(messages[0]) if messages else "—") }}</td>
    <td class="rejected">—</td>
    {% endif %}
  </tr>
  {% endfor %}
</table></div>
{% else %}
<p class="muted">{{ _("web.no_history") }}</p>
{% endif %}
{% endif %}

<h2>{{ _("web.limits_title") }}</h2>
<ul>
  <li>{{ _("web.limit_status") }}</li>
  <li>{{ _("web.limit_predictions") }}</li>
  <li>{{ _("web.limit_statistics") }}</li>
  <li>{{ _("web.limit_open") }}</li>
</ul>
<p>{{ _("web.links") }} <a href="{{ github }}">{{ github }}</a></p>
{% endblock %}
