<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}MedVision QA{% endblock %}</title>
<style>
  :root { --fg:#1d232a; --muted:#5b6672; --line:#d5dbe1; --bg-alt:#f4f6f8; --accent:#1f4e79;
          --ok:#1f6f3f; --ok-bg:#e4f3ea; --ko:#a32222; --ko-bg:#fbe7e7; --inc:#8a5a00; --inc-bg:#fdf1d8; }
  * { box-sizing: border-box; }
  body { font: 15px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, "Hiragino Sans", "Yu Gothic UI", Meiryo, sans-serif;
         color: var(--fg); max-width: 1000px; margin: 0 auto; padding: 24px; }
  header.top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
               border-bottom: 1px solid var(--line); margin-bottom: 16px; }
  header.top a.home { color: var(--fg); text-decoration: none; font-weight: 700; font-size: 1.2rem; }
  h1 { font-size: 1.4rem; } h2 { font-size: 1.1rem; margin-top: 28px; }
  a { color: var(--accent); }
  .muted, .note { color: var(--muted); } .note { font-size: .85rem; }
  code { font-family: ui-monospace, Consolas, monospace; font-size: .85rem; overflow-wrap: anywhere; }
  table { border-collapse: collapse; width: 100%; font-size: .9rem; }
  th, td { border: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
  th { background: var(--bg-alt); }
  .state { display: inline-block; padding: 1px 8px; border-radius: 4px; font-weight: 700; font-size: .85rem; }
  .SATISFIED { color: var(--ok); background: var(--ok-bg); }
  .NOT_SATISFIED { color: var(--ko); background: var(--ko-bg); }
  .INCONCLUSIVE { color: var(--inc); background: var(--inc-bg); }
  .rejected { color: var(--muted); font-style: italic; }
  .errors { border: 1px solid var(--ko); background: var(--ko-bg); padding: 8px 16px; }
  .errors li { font-family: ui-monospace, Consolas, monospace; font-size: .85rem; }
  form.upload { border: 1px solid var(--line); padding: 16px; background: var(--bg-alt); }
  form.upload label { display: block; font-weight: 600; margin-top: 12px; }
  button { margin-top: 16px; padding: 6px 16px; font: inherit; font-weight: 600; cursor: pointer; }
  .actions a { display: inline-block; margin: 0 16px 8px 0; }
  footer { margin-top: 40px; border-top: 1px solid var(--line); }
  .lead { font-size: 1.05rem; }
  .scroll { overflow-x: auto; }
  .scroll code { overflow-wrap: normal; }
  .notice { border-left: 4px solid var(--inc); background: var(--inc-bg); padding: 8px 16px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  a.card { display: block; border: 1px solid var(--line); border-radius: 6px; padding: 12px 16px;
           color: var(--fg); text-decoration: none; }
  a.card:hover, a.card:focus { border-color: var(--accent); background: var(--bg-alt); }
  a.card strong { color: var(--accent); }
  input[type=file] { max-width: 100%; }
  .previews details { border: 1px solid var(--line); border-radius: 6px; padding: 6px 12px; margin: 8px 0; }
  .previews summary { cursor: pointer; }
  .previews details[open] summary { margin-bottom: 8px; }
  .previews pre { background: var(--bg-alt); padding: 8px 12px; overflow-x: auto; margin: 0;
                  font: .8rem/1.5 ui-monospace, Consolas, monospace; }
  .previews td code, .previews th code { overflow-wrap: normal; }
  @media (max-width: 600px) {
    body { padding: 12px; font-size: 14px; }
    header.top { flex-direction: column; gap: 0; }
  }
</style>
</head>
<body>
<header class="top">
  <a class="home" href="{{ url('/') }}">MedVision QA</a>
  <span class="muted">{{ _("web.public_banner") if public else _("web.local_only") }} ·
    {% if lang == "ja" %}<a href="{{ path }}" lang="en" hreflang="en">English</a>{% else %}<a href="{{ path }}?lang=ja" lang="ja" hreflang="ja">日本語</a>{% endif %}</span>
</header>
{% block content %}{% endblock %}
<footer class="note"><p>{{ _("web.footer") }} <a href="{{ github }}">GitHub</a></p></footer>
</body>
</html>
